{
  "name": "devon-ai-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone backend API for Devon AI. Mounts the existing app/ai-* route handlers on their own server.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
