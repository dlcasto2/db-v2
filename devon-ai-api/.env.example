# --- Server ---
PORT=8787

# Browser origins allowed to call this API (comma-separated).
# Add your deployed Devon site's exact origin when deploying the API.
DEVON_API_ALLOWED_ORIGINS=http://localhost:3000

# Optional. When set, any request whose Origin is NOT in the list above must send
# "Authorization: Bearer <key>" or "x-devon-api-key: <key>". For server-to-server callers.
DEVON_API_KEY=

# --- Devon AI (same variables the Vercel backend already uses) ---
ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_MODEL=
# CLAUDE_MODEL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
E2B_API_KEY=
DEVON_AI_DAILY_LIMIT=30
DEVON_AI_IP_DAILY_LIMIT=0
DEVON_AI_SANDBOX_DAILY_LIMIT=5
DEVON_AI_ADMIN_KEY=
