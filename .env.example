# Devon environment variables. Set them in the EdgeOne project settings
# (or copy this file to .env for local runs). Never commit real values.

# ── Devon AI (agents/) ─────────────────────────────────────────────────────
# Makers Models: Makers console → Models → API Key
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
# Optional; defaults to the free @makers/deepseek-v4-flash
AI_GATEWAY_MODEL=
# Or call the Anthropic API directly instead of a gateway
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Messages per visitor per day (0 = no limit) and an optional shared cap per network
DEVON_AI_DAILY_LIMIT=30
DEVON_AI_IP_DAILY_LIMIT=0
# Only for the agent's web search tool
WSA_API_KEY=

# ── Devon AI "AirLLM" provider (see airllm-server/README.md) ───────────────
# Your airllm-server, reachable from this backend, and its AIRLLM_API_KEY
DEVON_AIRLLM_BASE_URL=
DEVON_AIRLLM_API_KEY=
# Optional: reply length cap (default 384), page text per question (default 6000),
# and a shorter reply time limit than the platform's (seconds)
DEVON_AIRLLM_MAX_TOKENS=
DEVON_AIRLLM_MAX_PAGE_CHARS=
DEVON_AIRLLM_TIMEOUT_SECONDS=

# ── Devon AI "OpenAI Agents" provider (see README → OpenAI Agents provider) ─
# Optional: an OpenAI-compatible endpoint of its own. Falls back to
# AI_GATEWAY_BASE_URL / AI_GATEWAY_API_KEY / AI_GATEWAY_MODEL above when unset.
DEVON_OPENAI_BASE_URL=
DEVON_OPENAI_API_KEY=
DEVON_OPENAI_MODEL=

# ── YouTube (see README → YouTube) ─────────────────────────────────────────
DEVON_YT_COOKIE=
DEVON_YT_PROXY=
DEVON_INVIDIOUS=
DEVON_YT_CLIENTS=

# ── Page safety check (see README → Page safety check) ─────────────────────
DEVON_JEV_API_KEY=
DEVON_JEV_BACKEND=
DEVON_JEV_MODEL=
DEVON_JEV_BASE_URL=
