node_modules
.next
*.tsbuildinfo
.env*
next-env.d.ts
.edgeone
!.env.example
# Regenerated by scripts/copy-vendor.mjs's postinstall hook on every install/
# deploy (ffmpeg.wasm's ~10 MB core, gzipped and split) — never hand-edited,
# so there's nothing here worth tracking in git.
public/vendor/ffmpeg-core/

# Desktop (Tauri) build — see desktop/README.md. All regenerated by
# `prepare-standalone.mjs` / `prepare-static.mjs` / `tauri build` / `tauri
# icon`, never hand-edited.
desktop/node_modules
desktop/src-tauri/target
desktop/src-tauri/resources
desktop/src-tauri/binaries
desktop/src-tauri/gen
desktop/static-dist
# `next build`'s static-export output (DEVON_DESKTOP_STATIC_BUILD) — staged
# into desktop/static-dist by prepare-static.mjs right after.
/out
# prepare-static.mjs's transient holding spot for app/api/** etc. while it
# builds. Should never exist outside of a running build; if it's here, a
# previous run's restore didn't finish — see prepare-static.mjs before
# deleting it.
/.desktop-static-excluded-routes
