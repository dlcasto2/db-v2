# AirLLM server for Devon AI. Copy to .env, fill in, then: python server.py
# (export the variables or use `set -a; . ./.env; set +a` — server.py doesn't read .env itself)

# ── Required ────────────────────────────────────────────────────────────────
# Hugging Face repo ID or a local model folder. An instruct/chat model, so its
# chat template is used. Bigger = smarter but slower: every generated token
# reads every layer from disk.
AIRLLM_MODEL=Qwen/Qwen3-32B
# Shared secret. Put the same value in Devon's DEVON_AIRLLM_API_KEY.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRLLM_API_KEY=

# ── Model loading (passed to AirLLM's AutoModel.from_pretrained) ────────────
# 4bit or 8bit block-wise compression: smaller shards, up to ~3x faster (needs bitsandbytes)
AIRLLM_COMPRESSION=
# cuda:0, cuda:1, mps or cpu; empty picks CUDA, then Apple MPS, then CPU
AIRLLM_DEVICE=
# Where AirLLM saves the per-layer shards (needs about the model's size in free space)
AIRLLM_SHARDS_PATH=
# 1 deletes the original download after splitting, to save half the disk space
AIRLLM_DELETE_ORIGINAL=0
# 1 overlaps loading the next layer with computing this one (no effect with compression)
AIRLLM_PREFETCHING=1
# For gated models (Llama, some Mistral repos)
HF_TOKEN=
# Extra arguments for the tokenizer's chat template, as JSON. For Qwen3 models,
# {"enable_thinking": false} skips the long <think> section, which matters a lot
# at AirLLM's speed.
AIRLLM_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}

# ── Limits ──────────────────────────────────────────────────────────────────
# Hard cap on tokens per reply, and the default when the caller doesn't say
AIRLLM_MAX_NEW_TOKENS=512
AIRLLM_DEFAULT_MAX_TOKENS=256
AIRLLM_DEFAULT_TEMPERATURE=0.6
# Longest prompt accepted; older chat turns are dropped first to fit
AIRLLM_MAX_INPUT_TOKENS=4096
# Requests allowed to wait behind the one being generated (more get 503 busy)
AIRLLM_MAX_QUEUE=2
# Seconds a request may wait in the queue, and the most one reply may take
AIRLLM_QUEUE_TIMEOUT=900
AIRLLM_MAX_SECONDS=1800
# Seconds between keepalive comments on a streamed reply
AIRLLM_KEEPALIVE_SECONDS=10

# ── Server ──────────────────────────────────────────────────────────────────
AIRLLM_HOST=0.0.0.0
AIRLLM_PORT=8790
AIRLLM_LOG_LEVEL=info
# airllm (default) or echo (no model; repeats your message — for testing the Devon wiring)
AIRLLM_BACKEND=airllm
# Only if this machine is unreachable from anywhere else: run without AIRLLM_API_KEY
AIRLLM_ALLOW_NO_AUTH=0
